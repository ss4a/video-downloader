{
  // Runs the web version of Video Downloader in GitHub Codespaces.
  // Open the repo on github.com -> Code -> Codespaces -> Create codespace.
  "name": "Video Downloader (web)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    // yt-dlp needs a JavaScript runtime for YouTube.
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg && pip install --user -r requirements-web.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Video Downloader",
      "onAutoForward": "openBrowser"
    }
  }
}
